# https://w3id.org/pices/odis/  ->  PICES ODIS JSON-LD directory
#
# Target: GitHub Pages of the public repository pices-data/odis (docs/ folder on main).
#
# 302 (not 301) so the target can move without clients caching a permanent redirect.
# Every path under /pices/odis/ is forwarded unchanged, so
#   https://w3id.org/pices/odis/sitemap.xml
#   https://w3id.org/pices/odis/records/zenodo-23504641.jsonld
#   https://w3id.org/pices/odis/catalog.jsonld
# resolve to the same paths on the GitHub Pages site. The files are JSON-LD already,
# so no content negotiation is needed; HTML clients get the directory's index.html.

Options +FollowSymLinks
RewriteEngine on

RewriteRule ^(.*)$ https://pices-data.github.io/odis/$1 [R=302,L]
